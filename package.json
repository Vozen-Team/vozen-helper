{
  "name": "vozen-helper",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Vozen Helper — bot de moderação Discord sob a licença AGPL-3.0-only.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "npm run build && node scripts/start-prod.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "register": "tsx src/bot/registerCommands.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "start:api": "node dist/api/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0"
  },
  "//overrides": "Correção do advisory high do undici (via discord.js->@discordjs/rest) sem breaking change (mesma major 6.x). NÃO correr `npm audit fix --force` — baixaria o discord.js para v13.",
  "overrides": {
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^5.0.5"
  }
}
