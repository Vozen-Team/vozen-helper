# ─── Vozen Helper — bot de moderação privado (single-guild) ──────────────────
# Copia este ficheiro para `.env` e preenche. NUNCA commitar o `.env`.

# Token do bot (Discord Developer Portal -> Bot). OBRIGATÓRIO.
DISCORD_TOKEN=
# Application/Client ID (Developer Portal -> General Information). OBRIGATÓRIO.
# Exemplo de preenchimento: CLIENT_ID=<ID_PUBLICO_DA_TUA_APP>.
CLIENT_ID=
# ID do ÚNICO servidor onde o bot pode operar. O bot sai de qualquer outra guild.
# OBRIGATÓRIO. (Ativa o "modo dev": os comandos são registados só neste guild,
# aparecem instantaneamente.)
# Exemplo de preenchimento: GUILD_ID=<ID_DO_TEU_SERVIDOR>.
GUILD_ID=
# Caminho da base de dados SQLite. Default: ./vozen-helper.db
DB_PATH=./vozen-helper.db
# Nível mínimo de log: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ─── API do painel (processo separado do bot) ────────────────────────────────
# Só necessárias para correr a API (`npm run start:api`), não para o bot.
# Única conta Discord autorizada a usar o painel. OBRIGATÓRIO (para a API).
# Exemplo de preenchimento: PANEL_ALLOWED_USER_ID=<ID_DA_TUA_CONTA_DISCORD>.
PANEL_ALLOWED_USER_ID=
# Segredo para assinar o cookie de sessão. OBRIGATÓRIO. >= 32 chars aleatórios.
# Gera um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PANEL_SESSION_SECRET=
# Porta local da API (default 8788). Só o túnel lhe acede (ouve em 127.0.0.1).
PANEL_API_PORT=8788
# Origem HTTPS do teu painel autorizada no CORS, sem barra final.
# Domínio fictício de exemplo; substitui pela origem do teu painel antes de ativar.
PANEL_ALLOWED_ORIGIN=https://admin.example.com

# Required when running the legacy TypeScript bot/API: fill all IDs below.
# The last two fields are required only by the manual ticket tool. No built-in IDs.
# IDs must be Discord snowflakes; *_IDS accepts comma-separated IDs.
# General/suggestions/starboard overrides also update the default welcome-DM mentions.
HELPER_COMMAND_CHANNEL_IDS=
HELPER_MOD_ROLE_IDS=
HELPER_GENERAL_CHANNEL_ID=
HELPER_LOG_CHANNEL_ID=
HELPER_AUTO_ROLE_ID=
HELPER_SUGGESTIONS_CHANNEL_ID=
HELPER_STARBOARD_CHANNEL_ID=
HELPER_MEMBER_COUNTER_CHANNEL_ID=
HELPER_NO_XP_CHANNEL_IDS=
HELPER_LEVEL_5_ROLE_ID=
HELPER_LEVEL_10_ROLE_ID=
HELPER_LEVEL_20_ROLE_ID=
HELPER_TICKET_STAFF_ROLE_ID=
HELPER_TICKET_TRANSCRIPT_CHANNEL_ID=
HELPER_TICKET_PANEL_CHANNEL_ID=
HELPER_TICKET_COUNTER_CHANNEL_ID=
