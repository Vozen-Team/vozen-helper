# ─── Vozen Helper — bot de moderação privado (single-guild) ──────────────────
# Copia este ficheiro para `.env` e preenche. NUNCA commitar o `.env`.

# Token do bot (Discord Developer Portal -> Bot). OBRIGATÓRIO.
DISCORD_TOKEN=
# Application/Client ID (Developer Portal -> General Information). OBRIGATÓRIO.
CLIENT_ID=
# ID do ÚNICO servidor onde o bot pode operar. O bot sai de qualquer outra guild.
# OBRIGATÓRIO. (Ativa o "modo dev": os comandos são registados só neste guild,
# aparecem instantaneamente.)
GUILD_ID=
# Caminho da base de dados SQLite. Default: ./vozen-helper.db
DB_PATH=./vozen-helper.db
# Nível mínimo de log: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ─── API do painel (processo separado do bot) ────────────────────────────────
# Só necessárias para correr a API (`npm run start:api`), não para o bot.
# Única conta Discord autorizada a usar o painel. OBRIGATÓRIO (para a API).
PANEL_ALLOWED_USER_ID=
# Segredo para assinar o cookie de sessão. OBRIGATÓRIO. >= 32 chars aleatórios.
# Gera um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PANEL_SESSION_SECRET=
# Porta local da API (default 8788). Só o túnel lhe acede (ouve em 127.0.0.1).
PANEL_API_PORT=8788
# HTTPS origin of your private panel; replace this fictional example.
PANEL_ALLOWED_ORIGIN=https://admin.example.com
# Rust runtime (multi-guild public Helper)
DISCORD_APPLICATION_ID=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://api.example.com/rust/api/oauth/callback
HELPER_OAUTH_SUCCESS_REDIRECT=https://bot.example.com/panel/helper-tracker/
# Fill in the public client ID of your dedicated site-login OAuth application.
# Keep the legacy variable only during migration; never place a client secret here.
VOZEN_ECOSYSTEM_OAUTH_CLIENT_ID=
# Optional legacy fallback: fill in your previous product OAuth app public ID.
VOZEN_OAUTH_CLIENT_ID=
# Dedicated Discord OAuth app + owner ID used only by the private Helper
# tracker at your private panel origin. Configure both together.
HELPER_PRIVATE_TRACKER_CLIENT_ID=
HELPER_PRIVATE_TRACKER_OWNER_ID=
HELPER_DATABASE_URL=data/vozen-helper.sqlite
# Optional runtime root included in the Helper product-footprint metric.
# Production deploys set this automatically to the active release.
HELPER_PRODUCT_ROOT=
HELPER_BIND_ADDR=127.0.0.1:3101
HELPER_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional current Top.gg v1 token. Keep it only on the server; the Helper
# validates it before publishing aggregate server/shard counts every 30 min.
HELPER_TOPGG_TOKEN=
# Keep false in production; direct Discord token sessions are legacy-only.
HELPER_ALLOW_LEGACY_SESSION=false
# Comma-separated HTTPS origins allowed to use the Helper API; replace these examples.
HELPER_ALLOWED_ORIGIN=https://bot.example.com,https://admin.example.com
VOZEN_ENTITLEMENT_URL=https://api.example.com/internal/v1/entitlements/resolve
VOZEN_ENTITLEMENT_SECRET=
# Official YouTube Data API v3 key (server-side only; never expose in the panel).
YOUTUBE_API_KEY=
# Official Twitch Helix/EventSub credentials (server-side only; never expose in the panel).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://api.example.com/rust/api/providers/twitch/eventsub
# Backwards-compatible alias accepted by the runtime.
TWITCH_CALLBACK_URL=
# Official Meta Graph API for an authorised professional Instagram account.
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v22.0
META_APP_APPROVED=false
# Explicit test-only escape hatch for an authorised Instagram tester account.
# Keep false in production; this is not Meta production approval.
META_INSTAGRAM_DEVELOPMENT_MODE=false
# Official TikTok Login Kit + Display API OAuth credentials. Tokens generated
# for creators are encrypted per Discord server and must not be copied here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.example.com/rust/api/providers/tiktok/oauth/callback
# Temporary legacy fallback only. Remove after every server reconnects through OAuth.
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_APP_APPROVED=false
# Official Kick Public API credentials and approval flag.
KICK_ACCESS_TOKEN=
KICK_API_BASE_URL=https://api.kick.com/public/v1
KICK_APP_APPROVED=false
# Stripe Connect is kept separate from the existing Vozen checkout. Do not
# enable until KYC, tax, refunds and support policies are approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_APPROVED=false

# Optional Web3 integrations (server-side only; never expose these in the panel).
# CoinGecko is public without a key; set this for the higher rate limits.
COINGECKO_API_KEY=
# Gas tracker accepts only HTTPS JSON-RPC endpoints for the allow-listed networks.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
# Wallet gating is read-only: SIWE verifies a wallet signature and the worker
# reads balances through an approved RPC. Never put private keys here.
SIWE_DOMAIN=
SIWE_URI=https://bot.example.com/panel/helper/
SIWE_SESSION_SECRET=
SIWE_ALLOWED_CONTRACTS=

# Optional legacy TypeScript configuration overrides. Blank/unset keeps existing defaults.
# IDs must be Discord snowflakes; *_IDS accepts comma-separated IDs.
# General/suggestions/starboard overrides also update the default welcome-DM mentions.
HELPER_COMMAND_CHANNEL_IDS=
HELPER_MOD_ROLE_IDS=
HELPER_GENERAL_CHANNEL_ID=
HELPER_LOG_CHANNEL_ID=
HELPER_AUTO_ROLE_ID=
HELPER_SUGGESTIONS_CHANNEL_ID=
HELPER_STARBOARD_CHANNEL_ID=
HELPER_MEMBER_COUNTER_CHANNEL_ID=
HELPER_NO_XP_CHANNEL_IDS=
HELPER_LEVEL_5_ROLE_ID=
HELPER_LEVEL_10_ROLE_ID=
HELPER_LEVEL_20_ROLE_ID=
HELPER_TICKET_STAFF_ROLE_ID=
HELPER_TICKET_TRANSCRIPT_CHANNEL_ID=
HELPER_TICKET_PANEL_CHANNEL_ID=
HELPER_TICKET_COUNTER_CHANNEL_ID=
